# ================================================
# 龙虾AI跨境无人店系统 - 环境变量配置模板
# ================================================
# 复制此文件为 .env 并填写您的配置
# cp .env.example .env

# ================================================
# 基础配置
# ================================================
APP_NAME=龙虾AI跨境无人店系统
APP_VERSION=3.0.0
DEBUG=true

# ================================================
# 数据库配置
# ================================================
# 开发环境使用 SQLite
DATABASE_URL=sqlite+aiosqlite:///./data/lobster_ai.db

# 生产环境建议使用 PostgreSQL
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/lobster_ai

# 或使用 MySQL
# DATABASE_URL=mysql+aiomysql://user:password@localhost:3306/lobster_ai

# 注意：生产环境数据库连接字符串应通过环境变量 DATABASE_URL 设置
# 不要在代码中硬编码数据库凭据

# Redis配置（用于缓存和会话）
REDIS_URL=redis://localhost:6379/0

# ================================================
# JWT认证配置
# ================================================
# 生产环境请使用强随机密钥
JWT_SECRET_KEY=your-super-secret-key-change-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=10080

# ================================================
# AI模型配置 - 豆包大模型
# ================================================
# 使用 coze-coding-dev-sdk，已预装，无需额外配置API Key
# 默认使用豆包 Agent 优化模型
DEFAULT_MODEL=doubao-seed-1-8-251228
DEFAULT_TEMPERATURE=0.7

# 如需直接调用火山引擎API（可选）
# DOUBAO_API_KEY=your-doubao-api-key
# DOUBAO_ENDPOINT=https://ark.cn-beijing.volces.com/api/v3

# DeepSeek配置（可选，用于备用模型）
# DEEPSEEK_API_KEY=your-deepseek-api-key

# ================================================
# 飞书机器人配置 - 必填
# ================================================
# 从飞书开放平台获取：https://open.feishu.cn/
FEISHU_APP_ID=cli_xxxxxxxxxxxx
FEISHU_APP_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
FEISHU_ENCRYPT_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
FEISHU_VERIFICATION_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ================================================
# TikTok Shop API配置 - 必填（如需上架功能）
# ================================================
# 从TikTok Shop开发者中心获取
TIKTOK_APP_KEY=your-tiktok-app-key
TIKTOK_APP_SECRET=your-tiktok-app-secret
TIKTOK_SHOP_ID=your-tiktok-shop-id

# ================================================
# Amazon SP-API配置 - 可选
# ================================================
# 如需亚马逊上架功能，填写以下配置
# AMAZON_CLIENT_ID=your-amazon-client-id
# AMAZON_CLIENT_SECRET=your-amazon-client-secret
# AMAZON_REFRESH_TOKEN=your-amazon-refresh-token
# AMAZON_SELLER_ID=your-amazon-seller-id

# ================================================
# 图片/视频生成API配置 - 可选
# ================================================
# IMAGE_API_KEY=your-image-api-key
# VIDEO_API_KEY=your-video-api-key

# ================================================
# 管理员配置
# ================================================
ADMIN_PHONE=13800138000
ADMIN_PASSWORD=admin123
