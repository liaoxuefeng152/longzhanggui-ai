# ===========================================
# 应用配置
# ===========================================
APP_NAME=龙虾AI跨境无人店系统
APP_VERSION=1.0.0
DEBUG=True
API_PREFIX=/api/v1

# ===========================================
# 数据库配置 (SQLite)
# ===========================================
DATABASE_URL=sqlite+aiosqlite:///./data/lobster_ai.db

# ===========================================
# Redis配置
# ===========================================
REDIS_URL=redis://redis:6379/0

# ===========================================
# JWT配置
# ===========================================
JWT_SECRET_KEY=your-super-secret-key-change-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=10080

# ===========================================
# AI模型配置
# ===========================================
# OpenAI
OPENAI_API_KEY=sk-xxx
OPENAI_BASE_URL=https://api.openai.com/v1

# 豆包/火山引擎
DOUBAO_API_KEY=
DOUBAO_ENDPOINT=

# DeepSeek
DEEPSEEK_API_KEY=

# 默认模型
DEFAULT_MODEL=gpt-4o-mini

# ===========================================
# 飞书配置
# ===========================================
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_ENCRYPT_KEY=
FEISHU_VERIFICATION_TOKEN=

# ===========================================
# 管理员配置 (首次初始化)
# ===========================================
ADMIN_PHONE=13800138000
ADMIN_PASSWORD=admin123
