# ============================================
# 开发环境 Dockerfile
# ============================================
FROM node:20-alpine
WORKDIR /app

# 安装pnpm
RUN corepack enable && corepack prepare pnpm@latest --activate

# 复制依赖配置
COPY package.json pnpm-lock.yaml ./

# 安装依赖
RUN pnpm install

# 复制源代码
COPY . .

# 创建数据目录
RUN mkdir -p /app/data/db /app/data/uploads

# 暴露端口
EXPOSE 5000

# 设置端口
ENV PORT=5000
ENV HOSTNAME="0.0.0.0"

# 启动开发服务
CMD ["pnpm", "dev"]
